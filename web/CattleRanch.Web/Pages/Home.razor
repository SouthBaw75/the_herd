@page "/"
@using System.Globalization
@using CattleRanch.Sim
@using CattleRanch.Sim.Persistence
@using CattleRanch.Sim.Systems
@inject IJSRuntime JS

<PageTitle>Cattle Ranch (prototype)</PageTitle>

@if (_screen == Screen.Start)
{
    <div class="start-wrap">
        <div class="start-card">
            <svg class="vignette" viewBox="0 0 480 200" role="img" aria-label="A small ranch at dusk">
                @((MarkupString)SceneArt.Vignette())
                <g transform="translate(295 158)">@((MarkupString)CowArt.Svg(VignetteCowA, 0.78, false, true, false, false))</g>
                <g transform="translate(408 172)">@((MarkupString)CowArt.Svg(VignetteCowB, 0.5, true, false, false, false))</g>
            </svg>
            <h1 class="start-title">CATTLE RANCH <span class="proto-tag">(prototype)</span></h1>
            <p class="premise">You inherit a run-down ranch: one paddock, ten head, and $15,000 in the bank. One recurring question — should you sell now?</p>
            <label class="seed-label" for="seed-input">World seed</label>
            <input id="seed-input" class="seed-input" @bind="_seedText" @bind:event="oninput" />
            <p class="seed-hint">Same seed, same ranch — a web run matches a console run.</p>
            <button id="start-btn" class="btn primary big" @onclick="StartRanching">Start Ranching</button>
            @if (_hasSave)
            {
                <button id="load-save-btn" class="btn big" @onclick="LoadClicked">Load Save</button>
            }
            @if (_loadError != null)
            {
                <p class="load-error">@_loadError</p>
            }
        </div>
    </div>
}
else if (_state != null)
{
    <div class="game @(_screen == Screen.GameOver ? "blurred" : "")">
        <div class="scene-panel">
            <div class="scene-frame">
                <svg id="pasture-scene" class="scene" viewBox="0 0 900 620" preserveAspectRatio="xMidYMid meet">
                    @((MarkupString)SceneArt.Sky(_state.Date.Season, _state.Weather.Condition))
                    @((MarkupString)SceneArt.Field(GrassFraction(), SoilHealth(), _state.Date.Season, _state.Weather.Condition))
                    @foreach (var p in PlaceHerd())
                    {
                        var pl = p;
                        <g class="cow-sprite @(pl.A.Id == _selectedId ? "selected" : "") @(_newborns.Contains(pl.A.Id) ? "newborn" : "")"
                           data-id="@pl.A.Id" @key="pl.A.Id"
                           transform="translate(@N(pl.X) @N(pl.Y))"
                           @onclick="() => SelectCow(pl.A)">
                            <g class="cow-amble" style="animation-duration:@N(pl.AmbleSec)s;animation-delay:-@N(pl.AmbleDelay)s">
                                @if (pl.A.Id == _selectedId)
                                {
                                    <ellipse class="select-ring" cx="@N(2 * pl.Scale)" cy="@N(38 * pl.Scale)" rx="@N(52 * pl.Scale)" ry="@N(10 * pl.Scale)" />
                                }
                                @((MarkupString)CowArt.Svg(pl.A, pl.Scale, pl.Flip, pl.Grazing, showName: true, newborn: _newborns.Contains(pl.A.Id)))
                            </g>
                        </g>
                    }
                    @if (_state.Herd.Count == 0)
                    {
                        @((MarkupString)"<text class=\"empty-field-note\" x=\"450\" y=\"420\">The paddock is very quiet.</text>")
                    }
                    @((MarkupString)SceneArt.WeatherOverlay(_state.Weather.Condition))
                </svg>

                <div class="hud hud-tl">
                    <div class="hud-chip">
                        <span class="hud-label">Week @WeekNumber</span>
                        <span id="date-value" class="hud-value">Year @_state.Date.Year · @_state.Date.Season · Day @_state.Date.DayOfSeason/@GameDate.DaysPerSeason</span>
                    </div>
                    <div class="hud-chip">
                        <span class="hud-label">Weather</span>
                        <span id="weather-value" class="hud-value">@WeatherEmoji() @WeatherLine()</span>
                    </div>
                    @if (_state.Date.Season == Season.Winter)
                    {
                        <div id="winter-banner" class="hud-chip winter-chip">❄️ Winter — grass sleeps till spring; upkeep doesn't.</div>
                    }
                </div>

                <div class="hud hud-tr">
                    <div class="hud-chip">
                        <span class="hud-label">Cash</span>
                        <span id="cash-value" class="hud-value cash">@Money(_state.Cash)</span>
                    </div>
                    <div class="hud-chip">
                        <span class="hud-label">Herd</span>
                        <span id="herd-count" class="hud-value">🐄 @_state.Herd.Count head</span>
                    </div>
                    <div class="hud-chip hud-actions">
                        <button id="save-btn" class="btn tiny" @onclick="SaveClicked">Save</button>
                        <button id="load-btn" class="btn tiny" @onclick="LoadClicked" disabled="@(!_hasSave)">Load</button>
                        @if (_saveNote != null)
                        {
                            <span class="save-note">@_saveNote</span>
                        }
                    </div>
                </div>

                <div class="hud hud-bl">
                    <span id="runway-line" class="hud-runway">@RunwayLine()</span>
                </div>
            </div>
            <button id="advance-btn" class="btn primary advance-btn" @onclick="AdvanceWeek">Advance 1 Week ▶</button>
        </div>

        <aside class="side">
            @{ var sel = SelectedAnimal; }
            @if (sel != null)
            {
                <section id="animal-card" class="card animal-card">
                    <div class="animal-card-top">
                        <svg class="portrait" viewBox="-74 -66 148 118" role="img" aria-label="Portrait of @DisplayName(sel)">
                            @((MarkupString)CowArt.Svg(sel, 1.0, false, false, false, false))
                        </svg>
                        <div class="animal-id-block">
                            <input id="card-name" class="card-name" value="@sel.Name" placeholder="unnamed — type a name"
                                   @onchange="e => SetName(sel, e.Value?.ToString())" />
                            <span id="card-id" class="card-id">@sel.Id · @sel.Breed</span>
                            <span class="card-vitals">@SexIcon(sel) @SexLabel(sel) · @(sel.AgeDays / GameDate.DaysPerSeason) seasons · @sel.WeightKg.ToString("F0", Inv) kg</span>
                            @if (sel.Pregnancy.IsPregnant)
                            {
                                <span class="card-preg">🤰 In calf — day @sel.Pregnancy.DaysPregnant of @_engine.Config.Breeding.GestationDays</span>
                            }
                        </div>
                    </div>
                    <div class="traits">
                        @foreach (var t in Traits(sel))
                        {
                            <div class="trait-row">
                                <span class="trait-label">@t.Label</span>
                                <div class="trait-bar"><div class="trait-fill" style="width:@(((int)t.Value))%"></div></div>
                                <span class="trait-num">@((int)t.Value)</span>
                            </div>
                        }
                    </div>
                    <div class="animal-card-actions">
                        <span class="card-quote">Today's quote <strong id="card-quote">@Money(Quote(sel))</strong></span>
                        <button id="card-sell-btn" class="btn sell-btn" @onclick="() => AskSell(sel)">Sell @DisplayName(sel)</button>
                    </div>
                </section>
            }
            else
            {
                <section class="card pick-hint">
                    <span class="pick-hint-cow">🐄</span> Click a cow out in the pasture to look her over — rename her, check her lines, get a quote.
                </section>
            }

            <section class="card market-card">
                <div class="market-top">
                    <div class="market-price-block">
                        <h2>Market</h2>
                        <div class="price-big" id="price-value">@Money(PricePerKg)<span class="per-kg">/kg</span></div>
                    </div>
                    <div class="land-mini">
                        <div class="bar-row">
                            <span class="bar-label">Grass</span>
                            <div class="bar"><div class="bar-fill grass" style="width: @Pct(GrassFraction())%"></div></div>
                            <span id="grass-pct" class="bar-value">@Pct(GrassFraction())%</span>
                        </div>
                        <div class="bar-row">
                            <span class="bar-label">Soil</span>
                            <div class="bar"><div class="bar-fill soil" style="width: @Pct(SoilHealth())%"></div></div>
                            <span class="bar-value">@Pct(SoilHealth())%</span>
                        </div>
                    </div>
                </div>
                @{ var pts = ChartPoints(); }
                @if (pts.Length > 0)
                {
                    <svg class="price-chart" viewBox="0 0 240 48" preserveAspectRatio="none" role="img" aria-label="Recent weekly prices">
                        <polyline points="@pts" fill="none" stroke="#6a994e" stroke-width="2" />
                    </svg>
                }
                else
                {
                    <div class="price-chart chart-empty">building price history…</div>
                }
                <p class="market-hint">@MarketHint() Herd worth @Money(HerdValue()) at the gate.</p>
            </section>

            <section class="card feed-card">
                <div class="feed-head">
                    <h2>@(_ledgerOpen ? "Ledger" : "Week reports")</h2>
                    <button id="ledger-toggle" class="btn tiny" @onclick="() => _ledgerOpen = !_ledgerOpen">
                        @(_ledgerOpen ? "◂ Reports" : "Ledger ▸")
                    </button>
                </div>
                @if (_ledgerOpen)
                {
                    <div id="ledger" class="herd-scroll">
                        <table class="herd-table">
                            <thead>
                                <tr><th>Name / ID</th><th>Sex</th><th>Age</th><th>Weight</th><th></th><th class="num">Quote</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var animal in _state.Herd)
                                {
                                    var a = animal;
                                    <tr class="@(a.Id == _selectedId ? "row-selected" : "")">
                                        <td class="name-cell">
                                            @if (_renamingId == a.Id)
                                            {
                                                <input @ref="_renameInput" class="rename-input" @bind="_renameText" @bind:event="oninput"
                                                       @onkeydown="e => RenameKey(e, a)" @onblur="() => CommitRename(a)" />
                                            }
                                            else
                                            {
                                                <button class="name-btn" title="Rename" @onclick="() => BeginRename(a)">@DisplayName(a)</button>
                                            }
                                        </td>
                                        <td>@SexIcon(a) @SexLabel(a)</td>
                                        <td>@(a.AgeDays / GameDate.DaysPerSeason) sns</td>
                                        <td>@a.WeightKg.ToString("F0", Inv) kg</td>
                                        <td class="preg-cell">@(a.Pregnancy.IsPregnant ? "🤰" : "")</td>
                                        <td class="num">@Money(Quote(a))</td>
                                        <td><button class="btn sell-btn" @onclick="() => AskSell(a)">Sell</button></td>
                                    </tr>
                                }
                                @if (_state.Herd.Count == 0)
                                {
                                    <tr><td colspan="7" class="empty-herd">The herd is empty. The paddock is very quiet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="reports-scroll">
                        @if (_reports.Count == 0)
                        {
                            <div class="report dim"><p class="report-line">No weeks on the books yet. Hit <em>Advance 1 Week</em>.</p></div>
                        }
                        @for (int i = 0; i < _reports.Count; i++)
                        {
                            var r = _reports[i];
                            <div class="report @(i == 0 ? "latest" : "dim")">
                                <h3>Week @r.Week@(r.DaysRun < 7 ? $" ({r.DaysRun} days)" : "")</h3>
                                @if (r.Events.Count == 0 && r.Births.Count == 0)
                                {
                                    <p class="report-line">• Quiet week. The weather held.</p>
                                }
                                @foreach (var e in r.Events)
                                {
                                    <p class="report-line">• @e</p>
                                }
                                @foreach (var b in r.Births)
                                {
                                    <p class="report-line birth">• 🐄 A calf was born! @b joins the herd.</p>
                                }
                                @if (r.HerdEmpty)
                                {
                                    <p class="report-line">• Herd: empty. The overhead bills arrive anyway.</p>
                                }
                                else
                                {
                                    <p class="report-line">• Herd: avg @r.AvgWeight.ToString("F0", Inv) kg (@Signed(r.AvgDelta) kg this week) @Trend(r.AvgDelta, 0.05)</p>
                                }
                                <p class="report-line">• Grass: @Pct(r.GrassFrac)% of capacity @Trend(r.GrassFrac - r.PreGrassFrac, 0.001) (was @Pct(r.PreGrassFrac)%)</p>
                                <p class="report-line">• Price: @Money(r.PrePrice)/kg → @Money(r.Price)/kg @Trend((double)(r.Price - r.PrePrice), 0.001)</p>
                                <p class="report-line">• Cash: @Money(r.PreCash) → @Money(r.Cash) (@Money(r.Cash - r.PreCash))</p>
                            </div>
                        }
                    </div>
                }
            </section>
        </aside>
    </div>

    @if (_pendingSale != null)
    {
        <div class="modal-backdrop">
            <div id="confirm-modal" class="modal-card">
                <p class="confirm-text">Sell @DisplayName(_pendingSale) (@SexLabel(_pendingSale), @_pendingSale.WeightKg.ToString("F0", Inv) kg) for <strong>@Money(Quote(_pendingSale))</strong>?</p>
                <div class="modal-actions">
                    <button id="confirm-sell-btn" class="btn primary" @onclick="ConfirmSell">Sell</button>
                    <button id="cancel-sell-btn" class="btn" @onclick="() => _pendingSale = null">Keep</button>
                </div>
            </div>
        </div>
    }

    @if (_screen == Screen.GameOver)
    {
        <div class="modal-backdrop dark">
            <div id="game-over" class="gameover-card">
                <h1>THE BANK HAS FORECLOSED</h1>
                <p>The ranch lasted <strong>@YearsSurvived full year@(YearsSurvived == 1 ? "" : "s")</strong> and <strong>@WeeksIntoYear week@(WeeksIntoYear == 1 ? "" : "s")</strong>.</p>
                <p>Final herd: @_state.Herd.Count head, sold at the gate for less than they were worth.</p>
                <p>Final cash: @Money(_state.Cash).</p>
                <p class="closing-line">The land will recover. It always does.</p>
                <button id="start-over-btn" class="btn primary big" @onclick="StartOver">Start Over</button>
            </div>
        </div>
    }
}

@code {
    private const string SaveKey = "cattle-ranch-save";
    private const int DaysPerWeek = 7;
    private const int ChartWeeks = 12;
    private const int MaxHistory = 16;
    private const int MaxReports = 3;

    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private enum Screen { Start, Playing, GameOver }

    // The one simulation engine (SimConfig.Default) — all game logic lives in
    // CattleRanch.Sim (D12); this page is presentation and bookkeeping only.
    private readonly SimulationEngine _engine = new();
    private RanchState? _state;
    private Screen _screen = Screen.Start;

    private string _seedText = WebNewGame.DefaultSeed.ToString(CultureInfo.InvariantCulture);
    private bool _hasSave;
    private string? _loadError;
    private string? _saveNote;

    // Play-layer trackers only — deliberately NOT sim state, reset on load
    // (mirrors the console prototype's Game.cs).
    private readonly List<decimal> _priceHistory = new();
    private int _lastSampledDay = -1;
    private readonly List<WeekReport> _reports = new();

    private Animal? _pendingSale;
    private string? _renamingId;
    private string _renameText = string.Empty;
    private bool _focusRename;
    private ElementReference _renameInput;

    // Scene state (presentation only): selection, ledger toggle, and the ids
    // of calves born on the most recent advance (they get a sparkle).
    private string? _selectedId;
    private bool _ledgerOpen;
    private readonly HashSet<string> _newborns = new();

    // Purely decorative animals for the start-screen vignette — never added to
    // any sim state, never ticked. Presentation props, like a painted sign.
    private static readonly Animal VignetteCowA =
        new("V-1", "", Sex.Female, "Hereford", 10 * GameDate.DaysPerSeason, 480, default);
    private static readonly Animal VignetteCowB =
        new("V-2", "", Sex.Female, "Angus", 10 * GameDate.DaysPerSeason, 470, default);

    private MarketConfig MarketCfg => _engine.Config.Market;
    private decimal PricePerKg => _state!.Market.PricePerKg(MarketCfg, _state.Date.Season);
    private int WeekNumber => _state!.Date.TotalDays / DaysPerWeek + 1;
    private int YearsSurvived => _state!.Date.TotalDays / GameDate.DaysPerYear;
    private int WeeksIntoYear => _state!.Date.TotalDays % GameDate.DaysPerYear / DaysPerWeek;

    private Animal? SelectedAnimal
    {
        get
        {
            if (_selectedId == null || _state == null)
            {
                return null;
            }

            foreach (Animal a in _state.Herd)
            {
                if (a.Id == _selectedId)
                {
                    return a;
                }
            }

            return null;
        }
    }

    private sealed record WeekReport(
        int Week, int DaysRun, List<string> Events, List<string> Births,
        bool HerdEmpty, double AvgWeight, double AvgDelta,
        double GrassFrac, double PreGrassFrac,
        decimal PrePrice, decimal Price, decimal PreCash, decimal Cash);

    protected override async Task OnInitializedAsync()
    {
        string? existing = await JS.InvokeAsync<string?>("localStorage.getItem", SaveKey);
        _hasSave = !string.IsNullOrEmpty(existing);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRename)
        {
            _focusRename = false;
            await _renameInput.FocusAsync();
        }
    }

    // ------------------------------------------------------------------
    // The pasture scene: stable per-animal placement + pose.
    // Cosmetic only — hash of the animal id, never state.Rng (D10).
    // ------------------------------------------------------------------

    private readonly record struct Placement(
        Animal A, double X, double Y, double Scale, bool Flip, bool Grazing,
        double AmbleSec, double AmbleDelay);

    private List<Placement> PlaceHerd()
    {
        int n = _state!.Herd.Count;
        int day = _state.Date.TotalDays;

        // Anchor positions from independent per-id hashes (decorrelated axes).
        var ids = new List<Animal>(_state.Herd);
        ids.Sort((a, b) => string.CompareOrdinal(a.Id, b.Id));
        var xs = new double[n];
        var ys = new double[n];
        for (int i = 0; i < n; i++)
        {
            uint hx = Hash(ids[i].Id + "#x");
            uint hy = Hash(ids[i].Id + "#y");
            xs[i] = 70 + (hx % 997u) / 996.0 * 760.0;           // 70..830
            ys[i] = 296 + (hy % 991u) / 990.0 * 258.0;          // 296..554
            KeepClearOfProps(ref xs[i], ref ys[i]);
        }

        // A few deterministic relaxation passes so cows don't stack: iterate
        // pairs in sorted-id order and nudge apart. Same herd => same result
        // every render; only cosmetic, no RNG involved.
        for (int pass = 0; pass < 3; pass++)
        {
            for (int i = 0; i < n; i++)
            {
                for (int j = i + 1; j < n; j++)
                {
                    double ddx = xs[j] - xs[i];
                    double ddy = (ys[j] - ys[i]) * 2.2;         // y separation is worth more
                    double dist = Math.Sqrt(ddx * ddx + ddy * ddy);
                    const double minDist = 96.0;
                    if (dist >= minDist || dist < 0.001)
                    {
                        continue;
                    }

                    double push = (minDist - dist) / 2.0;
                    double ux = ddx / dist, uy = ddy / dist / 2.2;
                    xs[i] = Math.Clamp(xs[i] - ux * push, 60, 840);
                    xs[j] = Math.Clamp(xs[j] + ux * push, 60, 840);
                    ys[i] = Math.Clamp(ys[i] - uy * push, 296, 554);
                    ys[j] = Math.Clamp(ys[j] + uy * push, 296, 554);
                    KeepClearOfProps(ref xs[i], ref ys[i]);
                    KeepClearOfProps(ref xs[j], ref ys[j]);
                }
            }
        }

        var list = new List<Placement>(n);
        for (int i = 0; i < n; i++)
        {
            Animal a = ids[i];
            uint h = Hash(a.Id);
            double x = xs[i], y = ys[i];
            bool calf = a.AgeDays < 6 * GameDate.DaysPerSeason;
            double depth = (y - 296) / 258.0;
            double scale = 0.60 + 0.34 * depth;
            if (calf)
            {
                scale *= 0.62;
            }

            bool flip = ((h >> 20) & 1u) == 1u;
            // Pose drifts with the calendar so the herd re-poses as weeks pass,
            // but is identical across re-renders of the same day.
            bool grazing = ((h >> 21) + (uint)(day / 2)) % 4u != 0u;
            double ambleSec = 14 + (h >> 22) % 9u;
            double ambleDelay = (h >> 13) % 17u;
            list.Add(new Placement(a, x, y, scale, flip, grazing, ambleSec, ambleDelay));
        }

        // Painter's order: farther (higher) cows first so near ones overlap.
        list.Sort((p, q) => p.Y.CompareTo(q.Y));
        return list;
    }

    /// <summary>Keep a cow out of the pond and off the barn footprint.</summary>
    private static void KeepClearOfProps(ref double x, ref double y)
    {
        double dx = (x - 745) / 155.0, dy = (y - 498) / 78.0;
        if (dx * dx + dy * dy < 1.0)
        {
            x -= 300;
        }

        if (x < 250 && y < 330)
        {
            y += 72;
        }
    }

    /// <summary>FNV-1a — a stable cosmetic hash of the animal id.</summary>
    private static uint Hash(string s)
    {
        unchecked
        {
            uint h = 2166136261;
            foreach (char c in s)
            {
                h = (h ^ c) * 16777619;
            }

            return h;
        }
    }

    private static string N(double v) => v.ToString("F1", Inv);

    private void SelectCow(Animal a) => _selectedId = _selectedId == a.Id ? null : a.Id;

    private async Task SetName(Animal a, string? value)
    {
        a.Name = (value ?? string.Empty).Trim();
        await SaveToStorage();
    }

    private readonly record struct TraitBar(string Label, float Value);

    private static IEnumerable<TraitBar> Traits(Animal a)
    {
        yield return new TraitBar("Growth", a.Genome.GrowthRate);
        yield return new TraitBar("Calving", a.Genome.CalvingEase);
        yield return new TraitBar("Marbling", a.Genome.Marbling);
        yield return new TraitBar("Mothering", a.Genome.Mothering);
        yield return new TraitBar("Heat tol.", a.Genome.HeatTolerance);
        yield return new TraitBar("Disease res.", a.Genome.DiseaseResistance);
        yield return new TraitBar("Fertility", a.Genome.Fertility);
    }

    // ------------------------------------------------------------------
    // Lifecycle: start / load / save / game over
    // ------------------------------------------------------------------

    private void StartRanching()
    {
        long seed = long.TryParse(_seedText.Trim(), NumberStyles.Integer, Inv, out long s)
            ? s
            : WebNewGame.DefaultSeed;
        _state = WebNewGame.Create(seed);
        ResetTrackers();
        SamplePrice();
        _loadError = null;
        _screen = Screen.Playing;
    }

    private async Task LoadClicked()
    {
        string? json = await JS.InvokeAsync<string?>("localStorage.getItem", SaveKey);
        if (string.IsNullOrEmpty(json))
        {
            _loadError = "No save found.";
            _hasSave = false;
            return;
        }

        try
        {
            _state = RanchSave.FromJson(json);
        }
        catch (Exception)
        {
            _loadError = "Could not read the save.";
            return;
        }

        // Play-layer trackers do not live in the save; start them over.
        ResetTrackers();
        SamplePrice();
        _loadError = null;
        _saveNote = "Loaded.";
        _screen = Screen.Playing;
    }

    private async Task SaveClicked()
    {
        await SaveToStorage();
        _saveNote = "Saved.";
    }

    private async Task SaveToStorage()
    {
        if (_state == null)
        {
            return;
        }

        await JS.InvokeVoidAsync("localStorage.setItem", SaveKey, RanchSave.ToJson(_state));
        _hasSave = true;
    }

    private async Task ClearSave()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", SaveKey);
        _hasSave = false;
    }

    private void StartOver()
    {
        _state = null;
        ResetTrackers();
        _seedText = WebNewGame.DefaultSeed.ToString(Inv);
        _screen = Screen.Start;
    }

    private void ResetTrackers()
    {
        _priceHistory.Clear();
        _lastSampledDay = -1;
        _reports.Clear();
        _pendingSale = null;
        _renamingId = null;
        _saveNote = null;
        _selectedId = null;
        _ledgerOpen = false;
        _newborns.Clear();
    }

    // ------------------------------------------------------------------
    // Advancing time — 7 × engine.Step, then a week report
    // ------------------------------------------------------------------

    private async Task AdvanceWeek()
    {
        if (_state == null || _screen != Screen.Playing)
        {
            return;
        }

        _pendingSale = null;
        _renamingId = null;
        _saveNote = null;
        _newborns.Clear();

        int week = WeekNumber;
        double preAvgWeight = AverageWeight();
        double preGrassFrac = GrassFraction();
        decimal prePrice = PricePerKg;
        decimal preCash = _state.Cash;

        var events = new List<string>();
        var births = new List<string>();
        WeatherCondition prevCond = _state.Weather.Condition;
        Season prevSeason = _state.Date.Season;
        bool broke = false;
        int daysRun = 0;

        for (int d = 1; d <= DaysPerWeek; d++)
        {
            BreedingReport report = _engine.Step(_state);
            daysRun = d;

            foreach (Animal calf in report.BornToday)
            {
                births.Add(calf.Id);
                _newborns.Add(calf.Id);
            }

            WeatherCondition cond = _state.Weather.Condition;
            if (cond != prevCond)
            {
                if (cond != WeatherCondition.Normal)
                {
                    events.Add($"Day {d}: {WeatherName(cond)} set in — should last ~{_state.Weather.TotalSpellDays} days.");
                }
                else
                {
                    events.Add($"Day {d}: the {WeatherName(prevCond).ToLowerInvariant()} broke. Back to fair weather.");
                }

                prevCond = cond;
            }

            if (_state.Date.Season != prevSeason)
            {
                events.Add($"Day {d}: the season turned — it is now {_state.Date.Season}, Year {_state.Date.Year}.");
                prevSeason = _state.Date.Season;
            }

            if (Economy.IsBroke(_state))
            {
                broke = true;
                break;
            }
        }

        _reports.Insert(0, new WeekReport(
            week, daysRun, events, births,
            _state.Herd.Count == 0, AverageWeight(), AverageWeight() - preAvgWeight,
            GrassFraction(), preGrassFrac, prePrice, PricePerKg, preCash, _state.Cash));
        if (_reports.Count > MaxReports)
        {
            _reports.RemoveAt(MaxReports);
        }

        SamplePrice();

        if (broke)
        {
            // Foreclosure clears the autosave — no reloading a doomed ranch.
            await ClearSave();
            _screen = Screen.GameOver;
        }
        else
        {
            await SaveToStorage();
        }
    }

    // ------------------------------------------------------------------
    // Selling / renaming
    // ------------------------------------------------------------------

    private void AskSell(Animal a) => _pendingSale = a;

    private async Task ConfirmSell()
    {
        if (_state == null || _pendingSale == null)
        {
            return;
        }

        if (_pendingSale.Id == _selectedId)
        {
            _selectedId = null;
        }

        Economy.SellAnimal(_state, MarketCfg, _pendingSale.Id);
        _pendingSale = null;
        await SaveToStorage();
        _saveNote = null;
    }

    private void BeginRename(Animal a)
    {
        _renamingId = a.Id;
        _renameText = a.Name;
        _focusRename = true;
    }

    private async Task RenameKey(KeyboardEventArgs e, Animal a)
    {
        if (e.Key == "Enter")
        {
            await CommitRename(a);
        }
        else if (e.Key == "Escape")
        {
            _renamingId = null;
        }
    }

    private async Task CommitRename(Animal a)
    {
        if (_renamingId != a.Id)
        {
            return;
        }

        a.Name = _renameText.Trim();
        _renamingId = null;
        await SaveToStorage();
    }

    // ------------------------------------------------------------------
    // Price history + chart (hand-rolled SVG polyline, no chart library)
    // ------------------------------------------------------------------

    private void SamplePrice()
    {
        if (_state == null || _state.Date.TotalDays == _lastSampledDay)
        {
            return;
        }

        _lastSampledDay = _state.Date.TotalDays;
        _priceHistory.Add(PricePerKg);
        if (_priceHistory.Count > MaxHistory)
        {
            _priceHistory.RemoveAt(0);
        }
    }

    private List<decimal> ChartWindow()
    {
        int count = Math.Min(_priceHistory.Count, ChartWeeks);
        return _priceHistory.GetRange(_priceHistory.Count - count, count);
    }

    private string ChartPoints()
    {
        List<decimal> w = ChartWindow();
        if (w.Count < 2)
        {
            return string.Empty;
        }

        decimal min = w.Min();
        decimal max = w.Max();
        if (max == min)
        {
            min -= 0.01m;
            max += 0.01m;
        }

        const double width = 240.0, height = 48.0, pad = 4.0;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < w.Count; i++)
        {
            double x = pad + i * ((width - 2 * pad) / (w.Count - 1));
            double y = pad + (1.0 - (double)((w[i] - min) / (max - min))) * (height - 2 * pad);
            if (i > 0)
            {
                sb.Append(' ');
            }

            sb.Append(x.ToString("F1", Inv)).Append(',').Append(y.ToString("F1", Inv));
        }

        return sb.ToString();
    }

    // ------------------------------------------------------------------
    // Small readers / formatters (mirroring the console's language)
    // ------------------------------------------------------------------

    private decimal Quote(Animal a) => _state!.Market.QuoteFor(a, MarketCfg, _state.Date.Season);

    private decimal HerdValue()
    {
        decimal total = 0m;
        foreach (Animal a in _state!.Herd)
        {
            total += Quote(a);
        }

        return total;
    }

    private double AverageWeight()
    {
        if (_state!.Herd.Count == 0)
        {
            return 0.0;
        }

        double sum = 0.0;
        foreach (Animal a in _state.Herd)
        {
            sum += a.WeightKg;
        }

        return sum / _state.Herd.Count;
    }

    private double GrassFraction()
    {
        double biomass = 0.0, capacity = 0.0;
        foreach (Paddock p in _state!.Paddocks)
        {
            biomass += p.GrassBiomass;
            capacity += p.CarryingCapacity;
        }

        return capacity > 0 ? biomass / capacity : 0.0;
    }

    private double SoilHealth()
    {
        // Single-paddock Phase 1; average keeps it honest if more appear.
        if (_state!.Paddocks.Count == 0)
        {
            return 0.0;
        }

        double sum = 0.0;
        foreach (Paddock p in _state.Paddocks)
        {
            sum += p.SoilHealth;
        }

        return sum / _state.Paddocks.Count;
    }

    private string RunwayLine()
    {
        decimal weeklyBurn = Economy.DailyBurn(_state!, MarketCfg) * DaysPerWeek;
        if (weeklyBurn <= 0)
        {
            return "No burn. Suspiciously comfortable.";
        }

        int weeks = (int)(_state!.Cash / weeklyBurn);
        string unit = weeks == 1 ? "week" : "weeks";
        return $"At current burn ({Money(weeklyBurn)}/week), cash lasts ~{weeks} {unit} with no sales.";
    }

    private string MarketHint()
    {
        double shock = _state!.Market.ShockOffset;
        if (shock < -0.05)
        {
            return "Market crashed — shock in effect.";
        }

        if (shock > 0.05)
        {
            return "Market spiking — shock in effect.";
        }

        string seasonal = _state.Date.Season switch
        {
            Season.Spring => "prices strong for spring",
            Season.Summer => "steady summer market",
            Season.Fall => "fall glut — the seasonal low",
            _ => "modest winter premium",
        };

        double drift = _state.Market.DriftMultiplier;
        if (drift > 1.04)
        {
            return Capitalize(seasonal + ", running hot.");
        }

        if (drift < 0.96)
        {
            return Capitalize(seasonal + ", running soft.");
        }

        return Capitalize(seasonal + ".");
    }

    private static string Capitalize(string s) =>
        s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s.Substring(1);

    private string WeatherLine()
    {
        WeatherState w = _state!.Weather;
        if (w.Condition == WeatherCondition.Normal)
        {
            return "Fair — no complaints";
        }

        int dayOfSpell = w.TotalSpellDays - w.DaysRemaining + 1;
        return $"{WeatherName(w.Condition)} — day {dayOfSpell} of ~{w.TotalSpellDays}";
    }

    private string WeatherEmoji() => _state!.Weather.Condition switch
    {
        WeatherCondition.Drought => "☀️",
        WeatherCondition.HeatWave => "🥵",
        WeatherCondition.Blizzard => "❄️",
        WeatherCondition.WetSpring => "🌧️",
        _ => "🌤️",
    };

    private static string WeatherName(WeatherCondition condition) => condition switch
    {
        WeatherCondition.Drought => "Drought",
        WeatherCondition.HeatWave => "Heat wave",
        WeatherCondition.Blizzard => "Blizzard",
        WeatherCondition.WetSpring => "Wet spell",
        _ => "Fair weather",
    };

    private static string SexIcon(Animal a) => a.Sex == Sex.Male ? "♂" : "♀";

    private static string SexLabel(Animal a)
    {
        bool calf = a.AgeDays < 6 * GameDate.DaysPerSeason;
        if (calf)
        {
            return a.Sex == Sex.Male ? "calf-m" : "calf-f";
        }

        return a.Sex == Sex.Male ? "bull" : "cow";
    }

    private static string DisplayName(Animal a) => string.IsNullOrEmpty(a.Name) ? a.Id : a.Name;

    private static string Money(decimal amount)
    {
        string sign = amount < 0 ? "−" : string.Empty;
        return sign + "$" + Math.Abs(amount).ToString("N2", Inv);
    }

    private static string Pct(double fraction)
    {
        if (double.IsNaN(fraction))
        {
            fraction = 0.0;
        }

        return (Math.Clamp(fraction, 0.0, 1.0) * 100.0).ToString("F0", Inv);
    }

    private static string Signed(double delta) =>
        (delta >= 0 ? "+" : "−") + Math.Abs(delta).ToString("F1", Inv);

    private static string Trend(double delta, double epsilon)
    {
        if (delta > epsilon) { return "▲"; }
        if (delta < -epsilon) { return "▼"; }
        return "→";
    }
}

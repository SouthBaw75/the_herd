# ============================================================
# Cattle Ranch — .gitignore
# Covers Unity editor artifacts + .NET build output for the
# headless sim solution under /sim.
# ============================================================

# ---- Unity generated ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta files should be COMMITTED (do not ignore *.meta)

# Unity crash/log
sysinfo.txt
*.stackdump
crashlog.txt

# Autogenerated VS/Rider project files (Unity regenerates these)
*.csproj
*.unityproj
*.sln.DotSettings.user
.vs/
.idea/
*.pidb
*.booproj
*.svd
*.userprefs

# NOTE: the exclusion of *.csproj/*.sln above is scoped away for the
# headless sim solution below, which IS tracked.

# ---- .NET build output (headless sim) ----
sim/**/bin/
sim/**/obj/
sim/**/[Dd]ebug/
sim/**/[Rr]elease/
*.user

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
*~

# ---- Keep the tracked sim solution & project files ----
!sim/**/*.csproj
!sim/**/*.sln

# ---- Generated sim DLL synced into Unity (built by unity/sync-sim.sh; D7) ----
unity/Assets/CattleRanch/Plugins/CattleRanch.Sim.dll

# ---- Prototype save files (created wherever the console game runs) ----
ranch-save.json

# ---- Web (Blazor) build output ----
web/**/bin/
web/**/obj/
web/**/pub/

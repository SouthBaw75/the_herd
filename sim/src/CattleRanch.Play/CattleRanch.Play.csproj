<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on any installed .NET >= 8 (players may have 9/10 from Homebrew
         etc.); without this the app demands exactly the 8.x runtime. -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CattleRanch.Play</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The prototype is presentation only: it reads/drives the sim through
         its public API. -->
    <ProjectReference Include="..\CattleRanch.Sim\CattleRanch.Sim.csproj" />
  </ItemGroup>

</Project>
